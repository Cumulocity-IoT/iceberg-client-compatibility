# Iceberg catalog of the test tenant, read through a read-only principal issued with the principals API
CATALOG_URI="https://iceberg.<environment-domain>/api/catalog"
CATALOG_WAREHOUSE="<tenant-id>"
CATALOG_CREDENTIAL="<clientId>:<clientSecret>"
CATALOG_TOKEN_URI="https://iceberg.<environment-domain>/api/catalog/v1/oauth/tokens"
CATALOG_SCOPE="PRINCIPAL_ROLE:ALL"

# Cumulocity tenant, for posting the fixture data (inventory, identity, measurement, event, alarm and operation
# write permissions); the tenant id also names the tenant's Dremio source
C8Y_BASEURL="https://<tenant-domain>"
C8Y_TENANT="<tenant-id>"
C8Y_USER="<user>"
C8Y_PASSWORD="<password>"

# Dremio Enterprise REST API, for the dremio client
DREMIO_URL="https://datahub.<environment-domain>:9447"
DREMIO_USER="<dremio-user>"
DREMIO_PASSWORD="<password>"
